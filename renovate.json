{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Bump the go directive in go.mod to each new Go release",
      "matchDatasources": ["golang-version"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Merge every update once CI passes",
      "matchPackageNames": ["*"],
      "automerge": true
    }
  ]
}
